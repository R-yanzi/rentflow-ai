# 应用基础配置
APP_NAME=RentFlow AI API
APP_VERSION=0.1.0
APP_DESCRIPTION=企业级智能租赁 Agent 平台后端服务
APP_API_V1_PREFIX=/api/v1
APP_DEBUG=false

# PostgreSQL 开发数据库
POSTGRES_DB=rentflow
POSTGRES_USER=rentflow
POSTGRES_PASSWORD=rentflow_dev_password
POSTGRES_PORT=5432

# FastAPI 后续使用的异步数据库连接地址
APP_DATABASE_URL=postgresql+asyncpg://rentflow:rentflow_dev_password@127.0.0.1:5432/rentflow

# DeepSeek
# 真实密钥只放在本地 .env，绝对不要提交到 Git。
APP_DEEPSEEK_API_KEY=
APP_DEEPSEEK_BASE_URL=https://api.deepseek.com
APP_DEEPSEEK_MODEL=deepseek-flash
APP_DEEPSEEK_TIMEOUT_SECONDS=30
APP_DEEPSEEK_MAX_TOKENS=1000